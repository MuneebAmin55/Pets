rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user can access only the dashboard stored under their own Firebase UID.
    // There is no shared admin dashboard or cross-user access.
    match /pawpalDashboards/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
